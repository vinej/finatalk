# OpenBB Platform API configuration
OPENBB_API_PORT=6900
OPENBB_API_HOST=0.0.0.0

# Provider API keys (OpenBB reads OPENBB_<PROVIDER>_API_KEY automatically)
# Yahoo Finance (yfinance) works without a key.

# Financial Modeling Prep — free tier at https://financialmodelingprep.com/
OPENBB_FMP_API_KEY=

# FRED — free key at https://fred.stlouisfed.org/docs/api/api_key.html
OPENBB_FRED_API_KEY=

# Optional providers
# OPENBB_POLYGON_API_KEY=
# OPENBB_TRADINGECONOMICS_API_KEY=
# OPENBB_INTRINIO_API_KEY=
