{
  "name": "@finatalk/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate --config=src/drizzle.config.ts",
    "db:migrate":  "drizzle-kit migrate  --config=src/drizzle.config.ts",
    "db:push":     "drizzle-kit push     --config=src/drizzle.config.ts",
    "studio":      "drizzle-kit studio   --config=src/drizzle.config.ts"
  },
  "dependencies": {
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "drizzle-kit": "^0.31.4",
    "typescript": "^5.6.3"
  }
}
